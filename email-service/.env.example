# Chiave API Resend (https://resend.com) per l'invio email
RESEND_API_KEY=
# Mittente: usa "onboarding@resend.dev" finché il dominio non è verificato su Resend
EMAIL_FROM=Magazzino Magliette <onboarding@resend.dev>
# Destinatario delle notifiche di vendita
EMAIL_TO=

# Origini autorizzate a chiamare questo servizio (separate da virgola)
ALLOWED_ORIGINS=https://bachatashop-claude.web.app,https://magazzino.bachatashop.eu,http://localhost:3000

# Billy Connect (emissione scontrino elettronico) — https://www.scontrinosenzacassa.it
BILLY_CODICE_LICENZA=
# Credenziali dell'Agenzia delle Entrate collegate a Billy
BILLY_AE_USER=
BILLY_AE_PASSWORD=
BILLY_AE_PIN=
# true (default) = scontrino fac-simile, NON trasmesso all'Agenzia delle Entrate.
# Impostare esplicitamente "false" solo quando si è pronti per l'invio reale.
BILLY_TEST_MODE=true
