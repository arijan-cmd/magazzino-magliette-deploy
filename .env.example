# Configurazione Firebase (Project Settings > General > Le tue app > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL del servizio email esterno (Render) da usare in produzione.
# In locale si può lasciare vuoto: si usa il server Express locale su /api/send-sale-mail.
VITE_EMAIL_API_URL=

# URL del servizio di emissione scontrino (stesso servizio Render dell'email) da usare in produzione.
# In locale si può lasciare vuoto: si usa il server Express locale su /api/emit-receipt.
VITE_RECEIPT_API_URL=

# Configurazione SMTP Aruba per l'invio email ad ogni vendita (solo per lo sviluppo locale)
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM=
SMTP_TO=

# Billy Connect (emissione scontrino elettronico, solo per lo sviluppo locale)
BILLY_CODICE_LICENZA=
BILLY_AE_USER=
BILLY_AE_PASSWORD=
BILLY_AE_PIN=
BILLY_TEST_MODE=true
